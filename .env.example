# ── Supabase ────────────────────────────────────────────────────────────
# Local (Supabase CLI): `npx supabase status` çıktısından al.
# Prod (cloud): Supabase proje ayarları > API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54341
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# GİZLİ — RLS bypass eden service role. Repoya ASLA girmez, sadece .env / deploy secret.
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket adları (opsiyonel; default images/demos/downloads)
SUPABASE_BUCKET_IMAGES=images
SUPABASE_BUCKET_DEMOS=demos
SUPABASE_BUCKET_DOWNLOADS=downloads

# ── Admin bootstrap (scripts/supabase-bootstrap.mjs) ──────────────────────
ADMIN_BOOTSTRAP_EMAIL=admin@portfolio.local
ADMIN_BOOTSTRAP_PASSWORD=

# ── Site ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3001
