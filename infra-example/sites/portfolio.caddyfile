# Portfolio site config — auto HTTPS via Let's Encrypt.
# Domain'i kendi domain'inle değiştir.

portfolio.your-domain.com, www.portfolio.your-domain.com {
    encode zstd gzip

    # Static asset uzun cache (image, demos, downloads, Next.js bundle)
    @static {
        path /assets/* /uploads/* /demos/* /downloads/* /logoDark/* /logoLight/* /_next/static/*
    }
    header @static Cache-Control "public, max-age=31536000, immutable"

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    # Reverse proxy → portfolio app container
    # portfolio-prod-app: docker-compose.production.yml içinde container_name
    reverse_proxy portfolio-prod-app:3001 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    log {
        output stdout
        format console
    }
}
