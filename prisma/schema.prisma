generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AboutContent {
  id              Int      @id @default(1)
  titleTr         String
  titleEn         String
  bioTr           String
  bioEn           String
  photoUrl        String?
  socialLinks     Json     @default("{}")
  siteTitle       String?
  siteDescription String?
  updatedAt       DateTime @updatedAt
}

model WorkExperience {
  id           String    @id @default(cuid())
  companyName  String
  roleTr       String
  roleEn       String
  descTr       String
  descEn       String
  startDate    DateTime
  endDate      DateTime?
  order        Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

enum DemoType {
  EXTERNAL_LINK
  EMBEDDED_HTML
  DOWNLOAD_ONLY
  VIDEO_ONLY
  GALLERY_ONLY
}

model Project {
  id          String         @id @default(cuid())
  slug        String         @unique
  titleTr     String
  titleEn     String
  summaryTr   String
  summaryEn   String
  descTr      String
  descEn      String
  coverImage  String?
  demoType    DemoType       @default(GALLERY_ONLY)
  demoUrl     String?
  demoFolder  String?
  downloadUrl String?
  videoUrl    String?
  repoUrl     String?
  isFeatured  Boolean        @default(false)
  order       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  images      ProjectImage[]
}

model ProjectImage {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  altTr     String?
  altEn     String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum PageKey {
  HOME
  ABOUT
  CAREER
  PROJECTS
  CONTACT
}

model PageSeo {
  id            String   @id @default(cuid())
  pageKey       PageKey  @unique
  titleTr       String?
  titleEn       String?
  descriptionTr String?
  descriptionEn String?
  ogImage       String?
  noIndex       Boolean  @default(false)
  updatedAt     DateTime @updatedAt
}
