# --- Production environment (copy to .env on the server) -------------------
# Generate JWT_SECRET with: openssl rand -base64 48
# Generate POSTGRES_PASSWORD with: openssl rand -base64 24

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://sezerdemirdedek.com

# --- PostgreSQL (used by docker-compose for the `db` service) ---------------
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM
# Not: POSTGRES_PORT yok — DB host'a expose edilmiyor (yalnız iç network).

# --- Auth -------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_TO_AT_LEAST_32_BYTES_OF_RANDOM
JWT_TTL_SECONDS=43200

# --- Admin bootstrap (only used on first prisma:seed run) -------------------
ADMIN_BOOTSTRAP_EMAIL=admin@sezerdemirdedek.com
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_STRONG
